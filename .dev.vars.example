# Copy to .dev.vars for local development with `npm run api`. Never commit .dev.vars.
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
# The administrator account is created the first time this email signs in with this password.
ADMIN_INITIAL_PASSWORD=
# Optional: which email is the administrator (the default is set in functions/_lib/auth.js).
# ADMIN_EMAIL=
